# Auto Trading Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# TimescaleDB / PostgreSQL
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=trading

# TimescaleDB 활성화 여부 (true/false)
ENABLE_TIMESCALEDB=false
TIMESCALEDB_HOST=localhost
TIMESCALEDB_PORT=5432
TIMESCALEDB_DATABASE=trading
TIMESCALEDB_USER=postgres
TIMESCALEDB_PASSWORD=your_secure_password_here
TIMESCALEDB_MIN_POOL_SIZE=10
TIMESCALEDB_MAX_POOL_SIZE=20

# ============================================
# Grafana
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_secure_password_here

# ============================================
# Redis Cache
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_ENABLED=true
REDIS_MAX_CONNECTIONS=50
REDIS_CACHE_TTL=60
REDIS_PRICE_TTL_MIN=1
REDIS_PRICE_TTL_MAX=10
REDIS_VOLATILITY_THRESHOLD=1.0

# ============================================
# Kiwoom API 설정
# ============================================
# 투자 구분: real(실전투자) / virtual(모의투자)
KIWOOM_TRADING_MODE=virtual

# API 인증 정보 (키움증권 OpenAPI+ 에서 발급)
# 모의투자 사용 시: https://mockapi.kiwoom.com 에서 발급받은 키 입력
# 실전투자 사용 시: https://openapi.kiwoom.com 에서 발급받은 키 입력
KIWOOM_API_KEY=your_app_key_here
KIWOOM_API_SECRET=your_app_secret_here
KIWOOM_ACCOUNT_NUMBER=12345678

# API Base URL (선택사항 - 미지정 시 TRADING_MODE에 따라 자동 설정)
# KIWOOM_API_BASE_URL=

# Rate Limit (선택사항 - 미지정 시 자동: 모의투자 1req/s, 실전투자 5req/s)
# KIWOOM_RATE_LIMIT_PER_SECOND=

# ============================================
# Simulator 설정
# ============================================
INITIAL_BALANCE=10000000

# ============================================
# Risk Management
# ============================================
DAILY_LOSS_LIMIT=500000
MAX_POSITION_CONCENTRATION=0.3

# ============================================
# Data Collection
# ============================================
DATA_POLLING_INTERVAL=1.0
USE_SMART_POLLING=true

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_DIR=logs

# ============================================
# Notifications (선택사항)
# ============================================
# Discord 웹훅 URL
DISCORD_WEBHOOK_URL=

# Email 알림 설정
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_email_password
EMAIL_RECIPIENTS=

# ============================================
# Application
# ============================================
APP_NAME=Kiwoom Auto Trading
DEBUG=false
DATA_DIR=data
DB_PATH=data/trading.db
