# 키움증권 API 설정
KIWOOM_API_KEY=your_api_key_here
KIWOOM_API_SECRET=your_api_secret_here
KIWOOM_ACCOUNT_NUMBER=your_account_number_here
KIWOOM_APP_KEY=your_app_key_here
KIWOOM_APP_SECRET=your_app_secret_here

# Redis 설정
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 알림 설정 (선택사항)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com

# 시스템 설정
LOG_LEVEL=INFO
LOG_DIR=logs
DATA_DIR=data
TIMEZONE=Asia/Seoul

# 위험 관리 설정
DAILY_LOSS_LIMIT=0.05  # 일일 손실 한도 5%
POSITION_SIZE_LIMIT=0.2  # 단일 종목 최대 비중 20%
MAX_ORDERS_PER_DAY=100  # 일일 최대 주문 수

# API 레이트 리밋 설정
API_RATE_LIMIT_PER_SECOND=10
API_RATE_LIMIT_PER_MINUTE=100

# 모니터링 설정
MONITORING_PORT=8080
METRICS_INTERVAL_SECONDS=60

# 개발 환경 설정
DEBUG=False
TESTING=False
SIMULATOR_MODE=False